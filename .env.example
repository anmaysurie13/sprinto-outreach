# Copy to .env.local (git-ignored). NEVER commit real values.

# Gemini — EITHER a Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OR an OpenRouter key (https://openrouter.ai/keys); the same Gemini model is called via OpenRouter.
# Used only when GEMINI_API_KEY is empty.
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Neon pooled connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Hunter.io Domain Search (https://hunter.io/api-keys)
HUNTER_API_KEY=

# Test sending — EITHER Resend (simplest; used when set). Without a verified domain, Resend only
# delivers to the email address of the Resend account owner, so TEST_EMAIL must be that address.
RESEND_API_KEY=
# Optional sender; default "Sprinto Outreach Test <onboarding@resend.dev>"
RESEND_FROM=

# OR Gmail API OAuth2 (scope: https://www.googleapis.com/auth/gmail.send only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The ONLY address the app will ever send to.
TEST_EMAIL=

